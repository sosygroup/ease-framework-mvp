  "bdi": {
    "baselineDesires": [
      "d1: reduce predicted avoidable food waste below the governance target",
      "d2: preserve the affected stakeholder's confirmation authority",
      "d3: comply with the hard prohibition on unauthorised external disclosure",
      "d4: avoid a more intrusive autonomy mode than necessary"
