      "stakeholderId": "regulator",
      "authority": "Data-protection law and stakeholder consent",
      "target": "External item-level disclosure",
      "applicability": "External disclosure is attempted",
      "precedence": 100,
      "weight": 0.0,
      "contestable": true,
      "violationHandling": "Block transmission and require authorised review",
      "revisionPolicy": "Only the governance owner may revise policy after legal review",
      "version": "C1"
    },
    {
      "id": "Csustainability",
      "principle": "Avoidable disposal of perishables remains below 10% in a 14-day window",
      "kind": "SOFT",
      "stakeholderId": "charlie",
      "authority": "Declared household sustainability preference",
      "target": "Avoidable waste ratio",
      "applicability": "Ordinary household shopping cycle",
      "precedence": 20,
      "weight": 0.65,
      "contestable": true,
      "violationHandling": "Escalate progressively under the autonomy ladder",
      "revisionPolicy": "The affected stakeholder may correct evidence or revise the preference",
      "version": "C1"
    },
    {
      "id": "Cautonomy",
      "principle": "The affected stakeholder confirms shopping-list changes unless standing consent exists",
      "kind": "SOFT",
      "stakeholderId": "charlie",
      "authority": "Explicit user-control preference",
      "target": "Shopping-list modification",
      "applicability": "A plan changes the shopping list",
      "precedence": 30,
      "weight": 0.35,
      "contestable": true,
      "violationHandling": "Require confirmation or reject the plan",
      "revisionPolicy": "The affected stakeholder may grant, withdraw, or challenge consent",
      "version": "C1"
    }
  ],
