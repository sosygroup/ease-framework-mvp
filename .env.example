# Optional governed LLM connector.
#
# The application reads these values from the process environment. The Bash
# scripts do not load this file automatically. To use a local copy:
#   cp .env.example .env
#   edit .env
#   set -a; source .env; set +a
#   ./scripts/run.sh

EASE_LLM_ENABLED=false
EASE_LLM_ENDPOINT=https://api.openai.com/v1/responses
EASE_LLM_PROTOCOL=RESPONSES
EASE_LLM_MODEL=gpt-5.6-luna
EASE_LLM_API_KEY=
EASE_LLM_AUTH_HEADER=Authorization
EASE_LLM_AUTH_SCHEME=Bearer
EASE_LLM_DATA_DISCLOSURE_CONSENT=false
EASE_LLM_TIMEOUT_SECONDS=30
